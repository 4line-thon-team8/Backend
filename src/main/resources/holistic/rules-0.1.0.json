  "rules": [
    {
      "id": "C1-ROLE-SPLIT-01",
      "indicator": "C1",
      "types": ["ROLE"],
      "sections": ["autonomy", "club", "subject"],
      "pattern": "역할을?\\s*(나누|분담|맡)",
      "excludes": ["(못했|못해|않|예정)"],
      "weight": 1.0,
      "examples": {
        "positive": ["팀원과 역할을 나누어 자료 조사와 발표를 맡음", "역할을 분담하여 실험을 진행함", "각자 역할을 맡아 프로젝트를 완성함"],
        "negative": ["역할을 나누지 못해 어려움을 겪음", "역할을 나눌 예정임", "혼자 자료를 조사함"]
      },
      "source": "분류 체계 v0.2 §3-1 ROLE (초안, 평가 가이드 원문 대조 전)"
    },
    {
      "id": "A3-METRIC-01",
      "indicator": "A3",
      "types": ["METRIC"],
      "sections": ["club", "career", "subject"],
      "pattern": "[0-9]+(\\.[0-9]+)?\\s*(%|퍼센트|명|회|건|개|점|시간|배)",
      "excludes": [],
      "weight": 1.0,
      "examples": {
        "positive": ["설문 120명 자료를 수집함", "실험을 3회 반복하여 평균을 구함", "정답률이 15% 향상됨"],
        "negative": ["많은 자료를 수집함", "여러 번 반복하여 확인함", "수업에 성실히 참여함"]
      },
      "source": "분류 체계 v0.2 §3-1 METRIC (초안, 평가 가이드 원문 대조 전)"
    },
    {
      "id": "A3-METHOD-01",
      "indicator": "A3",
      "types": ["METHOD"],
      "sections": ["autonomy", "club", "career", "subject"],
      "pattern": "(실험|설문|통계|회귀분석|크롤링|시뮬레이션|알고리즘|파이썬|프로그래밍)",
      "excludes": ["(예정|해\\s*보고\\s*싶)"],
      "weight": 1.0,
      "examples": {
        "positive": ["설문을 설계하고 통계 분석을 수행함", "파이썬으로 데이터를 시각화함", "시뮬레이션 프로그램을 구현함"],
        "negative": ["실험을 해 볼 예정임", "열심히 공부함", "책을 읽고 감상을 나눔"]
      },
      "source": "분류 체계 v0.2 §3-1 METHOD (초안, 평가 가이드 원문 대조 전)"
    },
    {
      "id": "B3-MOTIVE-01",
      "indicator": "B3",
      "types": ["MOTIVE"],
      "sections": ["autonomy", "club", "career", "subject"],
      "pattern": "(궁금증이?\\s*생|문제를\\s*발견|문제의식|의문을\\s*가지)",
      "excludes": [],
      "weight": 1.0,
      "examples": {
        "positive": ["일상 속 현상에 궁금증이 생겨 탐구를 시작함", "교내 에너지 낭비 문제를 발견하고 해결 방안을 탐색함", "문제의식을 느껴 주제를 선정함"],
        "negative": ["선생님이 제시한 주제로 진행함", "과제라서 수행함", "자료를 정리하여 제출함"]
      },
      "source": "분류 체계 v0.2 §3-1 MOTIVE (초안, 평가 가이드 원문 대조 전)"
    },
    {
      "id": "D4-REFLECTION-01",
      "indicator": "D4",
      "types": ["REFLECTION"],
      "sections": ["autonomy", "club", "career", "subject"],
      "pattern": "(한계를?\\s*(인식|느끼|극복)|보완하|후속\\s*탐구|심화\\s*탐구)",
      "excludes": [],
      "weight": 1.0,
      "examples": {
        "positive": ["표본이 작은 한계를 인식하고 표본을 늘려 보완함", "후속 탐구로 변수를 확장함", "결과의 오차를 보완하여 재실험함"],
        "negative": ["결과를 발표함", "한계가 없다고 생각함", "보고서를 제출함"]
      },
      "source": "분류 체계 v0.2 §3-1 REFLECTION (초안, 평가 가이드 원문 대조 전)"
    }
  ]
}
