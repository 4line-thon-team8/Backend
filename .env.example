# 이 파일을 복사해서 .env 를 만든다. (.env 는 Git에 올라가지 않는다)
#   cp .env.example .env
# DB_PASSWORD 는 반드시 직접 정한 값으로 바꾼다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fivegrade
DB_USER=fivegrade
DB_PASSWORD=changeme
# OpenAPI 문서와 Swagger UI. 로컬 개발에서만 true 로 둔다. (값이 없으면 꺼짐 = 운영 기본값)
#   문서: http://localhost:8080/v3/api-docs   UI: http://localhost:8080/swagger-ui.html
OPENAPI_ENABLED=true
